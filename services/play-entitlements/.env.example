ENTITLEMENT_PACKAGE_NAME=com.example.game
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/google-service-account.json
ENTITLEMENT_PRIVATE_KEY_FILE=/run/secrets/entitlement-private.pem
HOST=127.0.0.1
PORT=8080
