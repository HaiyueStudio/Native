{
  "compilerOptions": {
    "target": "ES2020",
    "module": "esnext",
    "strict": true,
    "experimentalDecorators": true,
    "noEmitHelpers": true,
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "types": [
      "@nativescript/types"
    ],
    "lib": [
      "ES2022",
      "DOM"
    ]
  },
  "include": [
    "src/**/*.ts",
    "node_modules/@haiyue/native/bridge/ui/**/*.ts"
  ]
}
