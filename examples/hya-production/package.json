    "text-encoding-utf-8": "1.0.2",
    "core-js-pure": "3.51.0"
  },
  "devDependencies": {
    "@babel/plugin-transform-unicode-property-regex": "7.29.7",
    "@nativescript/ios": "9.0.3",
    "@nativescript/types": "9.0.0",
    "@nativescript/webpack": "5.0.38",
    "@webgpu/types": "0.1.64",
    "nativescript": "9.1.1",
    "opentype.js": "1.3.4",
    "typescript": "5.7.3",
    "webpack": "5.110.3"
  },
  "engines": {
    "node": ">=22"
  },
  "allowScripts": {
    "@nativescript/core@9.1.1": true,
    "nativescript@9.1.1": true
  }
