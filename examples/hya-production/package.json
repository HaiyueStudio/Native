    "test:pcm": "node test/run-pcm-bridge.mjs",
    "doctor": "node scripts/ios.mjs doctor ios",
    "bundle:ios": "node scripts/ios.mjs prepare ios",
    "build:ios": "node scripts/ios.mjs build ios --for-device",
    "run:ios": "node scripts/ios.mjs run ios",
    "build:device": "node scripts/build-device.mjs"
  },
  "dependencies": {
    "@haiyue/animation-spec": "file:vendor/haiyue-animation-spec-0.2.2.tgz",
